{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "eDefter Berat Goruntuleyici",
  "mainBinaryName": "berat-goruntuleyici",
  "version": "1.0.0",
  "identifier": "tr.edefter.berat-goruntuleyici",
  "build": {
    "beforeDevCommand": "node prepare-frontend.mjs",
    "beforeBuildCommand": "node prepare-frontend.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "eDefter Berat Görüntüleyici",
        "url": "popup.html?workspace=1",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http://tauri.localhost https://tauri.localhost https://fonts.googleapis.com https://fonts.gstatic.com; frame-src 'self' blob:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "languages": ["Turkish", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
