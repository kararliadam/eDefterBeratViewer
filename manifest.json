{
  "manifest_version": 3,
  "name": "eDefter Berat Görüntüleyici",
  "version": "1.0.0",
  "description": "e-Defter berat XML ve ZIP dosyalarını geniş ekranda görüntüler ve PDF olarak indirir",
  "permissions": [
    "storage",
    "tabs",
    "contextMenus"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "host_permissions": [
    "file://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "eDefter Berat Görüntüleyici"
  },
  "content_scripts": [
    {
      "matches": ["file://*/*.xml", "file://*/*.XML"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "xslt/*.xslt",
        "viewer.html"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
